  lines:
  - text: Broccoli. Ancient Romans grew broccoli in Italy!
    clip: {fileID: 8300000, guid: 447ffb01d5d56b54a9a3ae1a696e16b4, type: 3}
    wordTimes:
    - 0.1
    - 1.545
    - 1.95
