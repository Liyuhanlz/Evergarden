    - 2.575
    - 3.075
    - 3.23
    wordStarts: 000000000a00000012000000190000001e000000270000002a000000
    wordLengths: 08000000070000000600000004000000080000000200000005000000
  - text: Broccoli. Broccoli plants grow about 2 to 3 feet tall.
    clip: {fileID: 8300000, guid: fee635ad98fab8f4582ecbc905aefb2e, type: 3}
    wordTimes:
    - 0.1
    - 1.545
    - 2.03
