    - 4.175
    - 4.345
    wordStarts: 000000000a00000013000000160000001d000000220000002b0000002e0000003000000034000000
    wordLengths: 08000000080000000200000006000000040000000800000001000000010000000300000001000000
  - text: 'Broccoli. In this game: ready after 2 watered days, then picked 3 times,
      regrowing in 1 day. Game days are sped up so you can watch it grow!'
